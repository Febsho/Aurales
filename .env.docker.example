# Point the hostname to this server before starting the stack.
AURALES_DOMAIN=aurales.example.com

# Use different random values. Keep this file private (mode 0600).
# Share only the access code with authorized Aurales users.
AURALES_MEDIA_API_KEY=replace-with-a-random-secret-at-least-32-characters
AURALES_MEDIA_SESSION_KEY=replace-with-a-different-random-secret-at-least-32-characters
AURALES_MEDIA_ACCESS_CODE=replace-with-a-private-instance-code-at-least-16-chars

# Exact upstream hostnames used by your media providers. The worker refuses
# media proxy and conversion requests for unlisted hosts.
AURALES_MEDIA_ALLOWED_HOSTS=cdn.example.net,video.example.org
