{
  "name": "aurales-app",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:macos": "tauri build --config src-tauri/tauri.macos.conf.json --target aarch64-apple-darwin --bundles app",
    "package:macos:dmg": "bash scripts/package-macos-dmg.sh",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:web": "tsc -b && vite build --config vite.web.config.ts && node scripts/check-web-bundle.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts --outDir dist-web",
    "test:browser": "playwright test",
    "test:browser:live": "playwright test tests/browser/live-media.spec.ts",
    "test:pwa": "npm run build:web && playwright test --config playwright.pwa.config.ts",
    "smoke:media-worker": "node scripts/smoke-media-worker.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "^2.11.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "tailwindcss": "^4.3.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
