VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TVDB_API_KEY=your_tvdb_api_key_here
VITE_TRAKT_CLIENT_ID=your_trakt_client_id_here

# Simkl OAuth credentials
# VITE_ prefix = bundled in JS (safe for public client ID)
# No VITE_ prefix = compiled into Rust binary only (secret stays off the JS bundle)
VITE_SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
VITE_SIMKL_REDIRECT_URI=http://localhost:42814/auth/simkl/callback

# Optional public MDBList OAuth client for browser sign-in.
# Register <deployed-origin>/auth/mdblist/callback as its redirect URI.
VITE_MDBLIST_CLIENT_ID=
# Defaults to <deployed-origin>/auth/mdblist/callback when omitted.
VITE_MDBLIST_WEB_REDIRECT_URI=

# Optional public AniList client ID for browser implicit-grant authorization.
# Register https://anilist.co/api/v2/oauth/pin as the client's Redirect URL.
VITE_ANILIST_WEB_CLIENT_ID=
